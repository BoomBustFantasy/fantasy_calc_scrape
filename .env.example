# Fantasy Calc Scrape - Environment Variables Example
# Copy this file to .env and fill in your actual values
# Note: .env file is ignored by Docker and Git for security

# BetterStack Logging Configuration
BETTERSTACK_SOURCE_TOKEN=hj4sWfQGqSmj4i5zdJ675Emb
BETTERSTACK_ENDPOINT=https://s1599507.eu-nbg-2.betterstackdata.com

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PROJECT_ID=your-project-id

# FantasyCalc API (if needed)
FANTASY_CALC_API_KEY=

# Cache Configuration
CACHE_TIMEOUT_MINUTES=15
CACHE_MAX_SIZE=1000
CACHE_ENABLED=true

# Resilience Configuration
MAX_RETRY_ATTEMPTS=3
TIMEOUT_SECONDS=30
DELAY_BETWEEN_RETRIES_SECONDS=2

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Application Settings
LOG_RETENTION_DAYS=30
