<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS8603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="HealthChecks\**" />
    <Content Remove="HealthChecks\**" />
    <EmbeddedResource Remove="HealthChecks\**" />
    <None Remove="HealthChecks\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- GitHub Packages -->
    <PackageReference Include="BoomBust.Logging" Version="1.0.1" />
    <PackageReference Include="BoomBust.HealthChecks" Version="1.0.0" />

    <!-- Public NuGet packages -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
    <PackageReference Include="Quartz" Version="3.15.0" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.15.0" />

    <!-- Supabase packages -->
    <PackageReference Include="Supabase" Version="1.1.1" />
  </ItemGroup>
</Project>